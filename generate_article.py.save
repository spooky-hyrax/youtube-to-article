import anthropic

with open("VKfE5BuqlSc.en.vtt", "r") as f:
    transcript = f.read()

client = anthropic.Anthropic(api_key="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 ")

message = client.messages.create(
    model="claude-opus-4-5",
    max_tokens=4000,
    messages=[
        {
            "role": "user",
            "content": f"""Convert this YouTube transcript into a long-form article.
- Use chapter titles as H2 headers
- Write in clear, engaging prose (not bullet points)
- Include a meta description at the top
- Include an intro paragraph and conclusion
- Preserve any important commands or technical terms exactly

Transcript:
{transcript}"""
        }
    ]
)

with open("article.md", "w") as f:
    f.write(message.content[0].text)

print("Done! Article saved to article.md"
